erDiagram
    %% ========================================================================
    %% ERD TERINTEGRASI SI-BLUD RS JIWA TAMPAN PROVINSI RIAU (v1.0)
    %% Sesuai database/migrations/ tanpa created_at & updated_at
    %% ========================================================================

    DIVISIONS ||--o{ UNITS : "has"
    DIVISIONS ||--o{ USERS : "has"
    DIVISIONS ||--o{ REQUISITIONS : "submits"
    UNITS ||--o{ USERS : "has"
    UNITS ||--o{ REQUISITIONS : "proposes"
    UNITS ||--o{ ITEMS : "proposes_custom"

    FISCAL_YEARS ||--o{ RBA_SHIFTS : "governs"
    FISCAL_YEARS ||--o{ RBA_ACCOUNTS : "governs"
    FISCAL_YEARS ||--o{ REQUISITIONS : "governs"
    FISCAL_YEARS ||--o{ REVENUES : "governs"

    RBA_SHIFTS ||--o{ RBA_EXPENSE_ITEMS : "contains"
    RBA_SHIFTS ||--o{ RBA_REVENUE_ITEMS : "contains"
    RBA_ACCOUNTS ||--o{ RBA_EXPENSE_ITEMS : "syncs_to"
    RBA_ACCOUNTS ||--o{ ITEMS : "classifies"
    RBA_ACCOUNTS ||--o{ REQUISITIONS : "funds"

    USERS ||--o{ REQUISITIONS : "creates (user_id)"
    USERS ||--o{ REQUISITIONS : "verifies (perencanaan)"
    USERS ||--o{ REQUISITIONS : "approves_disburses (keuangan)"

    REQUISITIONS ||--|{ REQUISITION_DETAILS : "contains"
    ITEMS ||--o{ REQUISITION_DETAILS : "referenced_in"
    RBA_REVENUE_ITEMS ||..o{ REVENUES : "target_vs_realization"

    DIVISIONS {
        bigint id PK
        varchar division_code "UK"
        varchar name
        varchar group "ENUM: Pelayanan_Keperawatan, Umum_Kepegawaian"
    }

    UNITS {
        bigint id PK
        bigint division_id FK
        varchar unit_code "UK"
        varchar name
        text description
    }

    USERS {
        bigint id PK
        varchar name
        varchar nip "UK"
        varchar email "UK"
        timestamp email_verified_at
        varchar password
        bigint division_id FK
        bigint unit_id FK
        enum role "ENUM: admin, perencanaan, keuangan, divisi"
        varchar position
        varchar phone
        boolean is_active
        varchar remember_token
        varchar avatar
    }

    FISCAL_YEARS {
        bigint id PK
        int year "UK"
        varchar name
        boolean is_active
        boolean is_default
        varchar description
    }

    RBA_SHIFTS {
        bigint id PK
        int year
        varchar shift_name
        varchar doc_title
        varchar period_month
        decimal penerimaan_silpa
        decimal penerimaan_divestasi
        decimal penerimaan_pinjaman
        decimal pengeluaran_investasi
        decimal pengeluaran_pokok_utang
        enum status "ENUM: Draft, Aktif, Arsip"
        text notes
    }

    RBA_EXPENSE_ITEMS {
        bigint id PK
        bigint rba_shift_id FK
        bigint rba_account_id FK
        varchar account_code
        varchar account_name
        varchar parent_code
        tinyint level
        boolean is_header
        decimal before_jasa_layanan
        decimal before_hasil_kerjasama
        decimal before_lain_lain_sah
        decimal before_silpa
        decimal before_apbd
        decimal before_total
        decimal after_jasa_layanan
        decimal after_hasil_kerjasama
        decimal after_lain_lain_sah
        decimal after_silpa
        decimal after_apbd
        decimal after_total
        decimal difference
        text keterangan
        int order_index
    }

    RBA_REVENUE_ITEMS {
        bigint id PK
        bigint rba_shift_id FK
        varchar item_code
        varchar item_name
        varchar parent_code
        tinyint level
        boolean is_header
        decimal before_amount
        decimal after_amount
        decimal difference
        text keterangan
        int order_index
    }

    RBA_ACCOUNTS {
        bigint id PK
        varchar account_code
        varchar parent_code
        varchar account_name
        varchar kategori_belanja "ENUM: Operasi, Modal"
        varchar sumber_dana "ENUM: BLUD, APBD"
        varchar funding_source
        int period_year
        int year
        decimal total_budget
        decimal budget_after_revision
        decimal remaining_budget
        decimal spent_budget
    }

    ITEMS {
        bigint id PK
        bigint rba_account_id FK
        varchar item_code "UK"
        varchar name
        text specification
        varchar unit_type
        varchar source "ENUM: STANDAR, USULAN_UNIT"
        bigint origin_unit_id FK
        decimal standard_price
    }

    REQUISITIONS {
        bigint id PK
        varchar requisition_number "UK"
        varchar nomor_surat_unit
        bigint division_id FK
        bigint unit_id FK
        bigint user_id FK
        bigint rba_account_id FK
        varchar jenis_belanja "ENUM: Operasi, Modal"
        varchar sumber_dana
        varchar program
        varchar kegiatan
        varchar sub_kegiatan
        text tolok_ukur_output
        varchar target_output
        text tolok_ukur_outcome
        varchar target_outcome
        text urgency_reason
        int fiscal_year
        int budget_year
        enum status "ENUM: Pending_Perencanaan, Diproses_Keuangan, Disetujui_Selesai, Ditolak"
        date submission_date
        decimal total_estimated
        decimal total_operasional
        decimal total_modal
        decimal total_approved
        text notes_perencanaan
        bigint verified_by_perencanaan_id FK
        timestamp verified_perencanaan_at
        text notes_keuangan
        bigint approved_by_keuangan_id FK
        timestamp approved_keuangan_at
        varchar sp2d_number
        varchar receipt_number
    }

    REQUISITION_DETAILS {
        bigint id PK
        bigint requisition_id FK
        bigint item_id FK
        varchar item_name
        varchar unit_type
        text specification
        int quantity_requested
        int quantity_approved
        decimal unit_price
        boolean exceeds_ssh
        decimal subtotal
    }

    REVENUES {
        bigint id PK
        varchar revenue_number "UK"
        varchar source "Pos Pendapatan BLUD"
        decimal amount
        date date
        text description
    }
