# ==============================================================================
# KONFIGURASI PRODUCTION E-BLUD RS JIWA TAMPAN PROVINSI RIAU
# ==============================================================================
# Salin file ini menjadi .env di server produksi: cp .env.production.example .env
# Jalankan perintah: php artisan key:generate
# ==============================================================================

APP_NAME="SI-BLUD RSJ Tampan"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://blud.rsjtampan.riau.go.id

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Logging: Rotasi harian dengan level warning untuk performa & efisiensi disk
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=warning

# ==============================================================================
# DATABASE (Wajib gunakan akun MySQL non-root dengan privilege terbatas)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siblud_production
DB_USERNAME=siblud_user
DB_PASSWORD=GantiPasswordDatabaseKuatIni123!#

# ==============================================================================
# SESSION & SECURITY HARDENING (HTTPS & Cookies Guard)
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ==============================================================================
# QUEUE & CACHE
# ==============================================================================
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ==============================================================================
# EMAIL NOTIFICATIONS (Opsional - SMTP Resmi Pemprov Riau / RSJ Tampan)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@rsjtampan.riau.go.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
