# File ini hanya berisi nilai yang menimpa .env.example untuk environment produksi
APP_KEY= # isi lewat php artisan key:generate
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<isi-domain>
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
LOG_STACK=daily
LOG_LEVEL=warning
SESSION_SECURE_COOKIE=true
DB_USERNAME=<akun-khusus-bukan-root>
DB_PASSWORD=<kuat>
